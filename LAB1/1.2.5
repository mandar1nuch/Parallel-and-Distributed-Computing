#include "iostream"
#include "thread"
#include "list"
#include "algorithm"
#include "mutex"
#include "chrono"

std::list <int>l;
std::mutex m;

void AddToList(int val) {
    std::lock_guard lock(m);
    l.push_back(val);
    std::cout << "Added: " << val << '\n';
}

void ListContains(int val) {
    std::lock_guard lock(m);
    bool found = std::find(l.begin(), l.end(), val) != l.end();
    std::cout << "Contains " << val << ": " << found << '\n';
}

int main() {
    int val = 5;
    for (int i = 0; i < 10; ++i) {
        std::thread(AddToList, val + i).detach();
        std::thread(ListContains, val).detach();
    }
    std::this_thread::sleep_for(std::chrono::milliseconds(500));
    return 0;
}
