namespace t6
{
    using Task = packaged_task<ull(ull)>;

    deque<Task> tasks;
    deque<ull> numbers;
    mutex m;
    condition_variable cv;
    bool stopFlag;

    void Worker()
    {
        while (true)
        {
            Task task;
            ull n;
            {
                unique_lock<mutex> lk(m);
                cv.wait(lk, [] { return stopFlag || !tasks.empty(); });
                if (tasks.empty()) return;
                task = move(tasks.front());
                tasks.pop_front();
                n = numbers.front();
                numbers.pop_front();
            }
            task(n);
        }
    }

    void run()
    {
        stopFlag = false;
        thread worker(Worker);
        vector<pair<ull, future<ull>>> results;

        while (true)
        {
            cout << "Введіть n (q - стоп): ";
            string s;
            if (!(cin >> s) || s == "q" || s == "Q") break;
            ull n;
            try { n = stoull(s); }
            catch (...) { cout << "Некоректне число\n"; continue; }
            if (n == 0) { cout << "n має бути >= 1\n"; continue; }

            Task task(nthPrime);
            results.emplace_back(n, task.get_future());
            {
                lock_guard<mutex> lk(m);
                tasks.push_back(move(task));
                numbers.push_back(n);
            }
            cv.notify_one();
        }

        for (auto& r : results)
            cout << r.first << "-те просте число: " << r.second.get() << endl;

        {
            lock_guard<mutex> lk(m);
            stopFlag = true;
        }
        cv.notify_one();
        worker.join();
        clearInput();
    }
}

namespace t7
{
    void First(ull n, promise<ull> p1, promise<bool> signal, promise<ull> p2)
    {
        p1.set_value(nthPrime(n));
        signal.set_value(true);
        p2.set_value(nthPrime(n * 10));
    }

    void Second(ull n, future<bool> signal)
    {
        signal.get();
        this_thread::sleep_for(chrono::seconds(2));
        cout << "[Потік 2] sqrt(" << n << ") = " << sqrt((double)n) << endl;
    }

    void run()
    {
        ull n;
        cout << "Введіть n: ";
        cin >> n;

        promise<ull> p1, p2;
        promise<bool> sig;
        future<ull> f1 = p1.get_future();
        future<ull> f2 = p2.get_future();
        future<bool> fs = sig.get_future();

        thread a(First, n, move(p1), move(sig), move(p2));
        thread b(Second, n, move(fs));

        cout << n << "-те просте число: " << f1.get() << endl;
        cout << (n * 10) << "-те просте число: " << f2.get() << endl;

        a.join();
        b.join();
    }
}

