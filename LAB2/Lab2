bool isPrime(long long n)
{
    if (n < 2) return false;
    if (n < 4) return true;
    if (n % 2 == 0) return false;
    for (long long d = 3; d * d <= n; d += 2)
        if (n % d == 0) return false;
    return true;
}

ull nthPrime(ull n)
{
    if (n == 0) return 0;
    vector<ull> primes;
    primes.reserve(n);
    primes.push_back(2);
    for (ull c = 3; primes.size() < n; c += 2)
    {
        bool ok = true;
        for (ull p : primes)
        {
            if (p * p > c) break;
            if (c % p == 0) { ok = false; break; }
        }
        if (ok) primes.push_back(c);
    }
    return primes[n - 1];
}

