namespace t2
{
    mutex m;
    condition_variable cv;
    int i;

    void Waits(int id)
    {
        unique_lock<mutex> lk(m);
        cout << "Потік Waits " << id << ": входжу у стан очікування\n";
        cv.wait(lk, [] { return i == 1; });
        cout << "Потік Waits " << id << ": очікування завершене\n";
    }

    void Awake()
    {
        this_thread::sleep_for(chrono::milliseconds(100));
        {
            lock_guard<mutex> lk(m);
            cout << "Awake: починаю повідомляти решту потоків\n";
        }
        cv.notify_all();
        this_thread::sleep_for(chrono::milliseconds(100));
        {
            lock_guard<mutex> lk(m);
            i = 1;
            cout << "Awake: повторне повідомлення\n";
        }
        cv.notify_all();
    }

    void run()
    {
        i = 0;
        thread w1(Waits, 1), w2(Waits, 2), w3(Waits, 3);
        thread a(Awake);
        a.join();
        w1.join();
        w2.join();
        w3.join();
    }
}

namespace t3
{
    struct State
    {
        mutex m;
        condition_variable cv;
        int i = 0;
    };

    void Worker(State* s, int id)
    {
        unique_lock<mutex> lk(s->m);
        cout << "Потік " << id << ": очікую на сигнал\n";
        s->cv.wait(lk, [s] { return s->i == 1; });
        cout << "Повідомлення з потоку " << id << endl;
    }

    void Notify(State* s)
    {
        this_thread::sleep_for(chrono::milliseconds(100));
        {
            lock_guard<mutex> lk(s->m);
            s->i = 1;
            cout << "Notify: пробуджую один потік\n";
        }
        s->cv.notify_one();
    }

    void run()
    {
        State* s = new State;
        thread t1(Worker, s, 1), t2(Worker, s, 2), t3(Worker, s, 3);
        t1.detach();
        t2.detach();
        t3.detach();
        thread n(Notify, s);
        n.join();
        this_thread::sleep_for(chrono::milliseconds(200));
    }
}

